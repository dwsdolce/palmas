require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

# CocoaPods before 1.12.1 generates an "[CP] Embed Pods Frameworks" script that
# resolves each framework with a bare `readlink`. An ordinary build is fine, but
# an Archive builds the frameworks behind a *relative* symlink into
# UninstalledProducts, so the script gets back a relative path that rsync, run
# from elsewhere, cannot resolve - and the archive dies with
#   rsync: ../../../IntermediateBuildFilesPath/UninstalledProducts/iphoneos/
#   Capacitor.framework: (l)stat: No such file or directory
# Device builds keep working throughout, so it surfaces only at the last step
# before an App Store upload. 1.12.1 switched the script to `readlink -f`.
#
# Refused here rather than discovered there: this file is evaluated on every
# `pod install`, which every iOS build triggers through `cap sync`, so an old
# CocoaPods fails the build at the start with a reason instead of at the end
# without one.
minimum_cocoapods = Gem::Version.new('1.12.1')
if Gem::Version.new(Pod::VERSION) < minimum_cocoapods
  raise "CocoaPods #{Pod::VERSION} is too old: #{minimum_cocoapods} or later is " \
        'needed to archive for the App Store. Update it with: gem install cocoapods'
end

platform :ios, '15.0'
use_frameworks!

# The upstream Capacitor template sets
#   install! 'cocoapods', :disable_input_output_paths => true
# as a workaround for stale Pods caching after installing new *Cordova*
# plugins. This project uses none, and the setting strips the input/output
# file lists off the "[CP] Embed Pods Frameworks" phase, which makes Xcode
# re-run it on every build and warn about it. Left at the CocoaPods default.

# CapacitorCordova's CDVWebViewProcessPoolFactory.h uses WKProcessPool, which
# Apple deprecated in iOS 15, so every build reports two deprecation warnings.
# It is upstream Capacitor code we do not call. Neither :inhibit_warnings nor
# inhibit_all_warnings! silences it: the warning is emitted while precompiling
# the Cordova Clang module for its *consumers*, which CocoaPods' warning
# settings do not reach. Suppressing it would mean -Wno-deprecated-declarations
# on the App target, which would also hide deprecations in our own code. Left
# visible on purpose; harmless, and it goes away when upstream fixes the header.
def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityKeepAwake', :path => '../../node_modules/@capacitor-community/keep-awake'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # Capacitor 8 ships a PrivacyInfo.xcprivacy with Capacitor and
  # CapacitorCordova, declared in their podspecs as resource_bundles. CocoaPods
  # gives every resource bundle its own target, and since Xcode 14 a bundle
  # target inherits a signing requirement - so a build stops with "Signing for
  # Capacitor-Capacitor requires a development team" before it ever reaches
  # this app's code.
  #
  # A resource bundle is signed with the app that embeds it, so signing it
  # separately buys nothing. Turning it off here keeps the fix in the project
  # rather than in each developer's Xcode settings, and needs no team id in a
  # public repository.
  installer.pods_project.targets.each do |target|
    next unless target.respond_to?(:product_type)
    next unless target.product_type == 'com.apple.product-type.bundle'

    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
    end
  end
end
