{
  "name": "palmas",
  "version": "1.0.0",
  "description": "A flamenco metronome",
  "productName": "Palmas",
  "desktopName": "palmas.desktop",
  "author": {
    "name": "David Smith",
    "email": "dws@dolcesfogato.com"
  },
  "homepage": "https://dolcesfogato.com/palmas",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "quasar dev",
    "build": "quasar build -m pwa",
    "preview": "node scripts/serve-static.mjs 4173 --directory dist/pwa",
    "build:desktop": "node packaging/build-desktop.mjs",
    "build:electron": "quasar build -m electron",
    "build:electron:dev": "quasar build -m electron --dev",
    "build:electron:prod": "quasar build -m electron --prod",
    "icons": "node scripts/icons.mjs",
    "postinstall": "quasar prepare && node scripts/icons.mjs && node scripts/format-audio.mjs convert --optional",
    "audio": "node scripts/format-audio.mjs convert",
    "audio:clean": "node scripts/format-audio.mjs unconvert"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.1.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@electron/remote": "^2.1.3",
    "@quasar/extras": "^1.17.0",
    "@types/animejs": "^3.1.13",
    "@vueuse/core": "^10.11.0",
    "animejs": "^3.2.1",
    "dompurify": "^3.1.6",
    "marked": "^14.1.0",
    "pinia": "^2.1.4",
    "quasar": "^2.17.0",
    "tone": "^15.0.4",
    "vue": "^3.4.31",
    "vue-global-events": "^3.0.1",
    "vue-i18n": "^9.13.1",
    "vue-router": "^5"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@quasar/app-vite": "^3",
    "@quasar/icongenie": "^6",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44",
    "electron-builder": "^26",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.3.2",
    "pug": "^3.0.3",
    "sharp": "^0.35.3",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^30 || ^28 || ^26 || ^24 || ^22.22.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
